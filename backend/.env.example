# === Whisper ASR ===
WHISPER_MODEL=large-v3
WHISPER_COMPUTE=int8
# === OCR ===
OCR_FPS=2
OCR_BOTTOM_RATIO=0.35
# === Translation ===
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
TRANSLATE_FALLBACK=nllb
# === TTS / Dubbing ===
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
DUB_MAX_SPILL_MS=400
DUB_MAX_SPEEDUP=1.3
DUB_CONCURRENCY=4
# === Storage ===
DATA_DIR=./data
MODELS_DIR=./models
# === Cleanup ===
RETENTION_HOURS=24
MAX_UPLOAD_GB=2
MAX_CONCURRENT_JOBS=3
# === Server ===
CORS_ORIGINS=http://localhost:3000,capacitor://localhost
DATABASE_URL=sqlite:///./data/db/zhvisub.db
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
