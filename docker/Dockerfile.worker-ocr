FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies required by PaddleOCR & OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    procps \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements-ocr.txt .
RUN pip install --upgrade pip && pip install -r requirements-ocr.txt

COPY backend/ /app/

CMD ["celery", "-A", "app.celery_app", "worker", "-Q", "ocr", "-c", "1", "--loglevel=info"]
